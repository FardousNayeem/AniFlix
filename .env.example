# Copy to .env and fill in. Never commit .env.

# --- Django core -----------------------------------------------------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_TIME_ZONE=Asia/Dhaka
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# --- Storage ---------------------------------------------------------------
DJANGO_DB_PATH=
DJANGO_MEDIA_ROOT=

# --- Google sign-in --------------------------------------------------------
# From Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID.
# Authorised redirect URI: http://127.0.0.1:8000/accounts/google/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Email -----------------------------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=ANIFLIX <no-reply@aniflix.test>
ACCOUNT_EMAIL_VERIFICATION=optional

# --- Store -----------------------------------------------------------------
CURRENCY_CODE=BDT
CURRENCY_SYMBOL=৳
CATALOG_PAGE_SIZE=12
SHOP_PAGE_SIZE=12
CART_MAX_QUANTITY_PER_ITEM=10

# --- Payments --------------------------------------------------------------
# 'dummy' skips the network and is the only safe choice for local work.
PAYMENT_GATEWAY=dummy
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# --- Production only -------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=true
